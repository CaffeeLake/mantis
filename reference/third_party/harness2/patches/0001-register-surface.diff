+def register_surface(name: str, *, surface_md: str, inv: str, dom: str, tts_surface: str) -> None:
+    """Add the prompt surface for a substrate this module does not ship (Mantis addition).
+
+    A downstream substrate supplies its own `# WHAT YOU CAN CHANGE` block (`surface_md`),
+    its INV and DOM authoring prompts and its tts surface text, and `_st(name)` resolves it
+    from then on. The builtin names are refused so upstream text is never replaced in
+    place; registering a downstream name again replaces that name's text.
+    """
+    if name in ("opencode", "codex"):
+        raise ValueError(f"cannot overwrite builtin prompt surface {name!r}")
+    _SURFACE_TEXTS[name] = _SurfaceText(
+        surface_md=surface_md, inv=inv, dom=dom, tts_surface=tts_surface
+    )
+
